{
  "name": "scribeflow",
  "version": "0.1.0",
  "description": "ScribeFlow — local Whisper transcription to word-timed subtitles (SRT/VTT/ASS)",
  "productName": "ScribeFlow",
  "build": {
    "appId": "com.scribeflow.app",
    "productName": "ScribeFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server.js",
      "transcribe.js",
      "srt.js",
      "subs.js",
      "public/**",
      "public-ui/**",
      "assets/**",
      "node_modules/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asar": false,
    "win": {
      "icon": "assets/icon.png",
      "target": "portable"
    }
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "cli": "node cli.js",
    "ui:build": "npm --prefix ui run build",
    "predist": "npm run ui:build",
    "desktop": "electron .",
    "dist": "electron-builder --win portable"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
